{
  "name": "@hijarvis/jar-slack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "jar-slack": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@hijarvis/jar-core": "workspace:*",
    "@slack/bolt": "^4.6.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  }
}
