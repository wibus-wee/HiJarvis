{
  "name": "HiJarvis",
  "version": "1.0.0",
  "private": true,
  "description": "HiJarvis workspace",
  "scripts": {
    "build": "pnpm -r --if-present --filter '!@hijarvis/wechat-sdk' build",
    "check": "pnpm -r --if-present --filter '!@hijarvis/wechat-sdk' check",
    "test": "pnpm -r --if-present --filter '!@hijarvis/wechat-sdk' test",
    "release": "pnpm build && pnpm publish -r --access public --no-git-checks",
    "dev": "pnpm --filter @hijarvis/cli dev --config ../../jar.toml",
    "dev:runtime": "pnpm --filter @hijarvis/runtime dev -- --config ../../jar.toml"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "docsify-cli": "^4.4.4",
    "tsdown": "^0.22.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
