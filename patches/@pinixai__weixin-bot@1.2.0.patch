+import { randomBytes, randomUUID } from 'node:crypto';
+import { MessageState, MessageType, MessageItemType, } from './types.js';
+export const DEFAULT_BASE_URL = 'https://ilinkai.weixin.qq.com';
+export const CHANNEL_VERSION = '1.0.0';
+export class ApiError extends Error {
+    status;
+    code;
+    payload;
+    constructor(message, options) {
+        super(message);
+        this.name = 'ApiError';
+        this.status = options.status;
+        this.code = options.code;
+        this.payload = options.payload;
+    }
+}
+function normalizeBaseUrl(baseUrl) {
+    return baseUrl.replace(/\/+$/, '');
+}
+function buildBaseInfo() {
+    return { channel_version: CHANNEL_VERSION };
+}
+async function parseJsonResponse(response, label) {
+    const text = await response.text();
+    const payload = text ? JSON.parse(text) : {};
+    if (!response.ok) {
+        const message = payload?.errmsg ?? `${label} failed with HTTP ${response.status}`;
+        throw new ApiError(message, {
+            status: response.status,
+            code: payload?.errcode,
+            payload,
+        });
+    }
+    if (typeof payload?.ret === 'number' && payload.ret !== 0) {
+        const body = payload;
+        throw new ApiError(body.errmsg ?? `${label} failed`, {
+            status: response.status,
+            code: body.errcode ?? body.ret,
+            payload,
+        });
+    }
+    return payload;
+}
+export function randomWechatUin() {
+    const value = randomBytes(4).readUInt32BE(0);
+    return Buffer.from(String(value), 'utf8').toString('base64');
+}
+export function buildHeaders(token) {
+    return {
+        'Content-Type': 'application/json',
+        AuthorizationType: 'ilink_bot_token',
+        Authorization: `Bearer ${token}`,
+        'X-WECHAT-UIN': randomWechatUin(),
+    };
+}
+export async function apiFetch(baseUrl, endpoint, body, token, timeoutMs = 40_000, signal) {
+    const url = new URL(endpoint, `${normalizeBaseUrl(baseUrl)}/`);
+    const timeoutSignal = AbortSignal.timeout(timeoutMs);
+    const requestSignal = signal ? AbortSignal.any([signal, timeoutSignal]) : timeoutSignal;
+    const response = await fetch(url, {
+        method: 'POST',
+        headers: buildHeaders(token),
+        body: JSON.stringify(body),
+        signal: requestSignal,
+    });
+    return parseJsonResponse(response, endpoint);
+}
+export async function apiGet(baseUrl, path, headers = {}) {
+    const url = new URL(path, `${normalizeBaseUrl(baseUrl)}/`);
+    const response = await fetch(url, {
+        method: 'GET',
+        headers,
+    });
+    return parseJsonResponse(response, path);
+}
+export async function getUpdates(baseUrl, token, buf, signal) {
+    const body = {
+        get_updates_buf: buf,
+        base_info: buildBaseInfo(),
+    };
+    return apiFetch(baseUrl, '/ilink/bot/getupdates', body, token, 40_000, signal);
+}
+export async function sendMessage(baseUrl, token, msg) {
+    return apiFetch(baseUrl, '/ilink/bot/sendmessage', {
+        msg,
+        base_info: buildBaseInfo(),
+    }, token, 15_000);
+}
+export async function getConfig(baseUrl, token, userId, contextToken) {
+    return apiFetch(baseUrl, '/ilink/bot/getconfig', {
+        ilink_user_id: userId,
+        context_token: contextToken,
+        base_info: buildBaseInfo(),
+    }, token, 15_000);
+}
+export async function sendTyping(baseUrl, token, userId, ticket, status) {
+    const body = {
+        ilink_user_id: userId,
+        typing_ticket: ticket,
+        status,
+        base_info: buildBaseInfo(),
+    };
+    return apiFetch(baseUrl, '/ilink/bot/sendtyping', body, token, 15_000);
+}
+export async function fetchQrCode(baseUrl) {
+    return apiGet(baseUrl, '/ilink/bot/get_bot_qrcode?bot_type=3');
+}
+export async function pollQrStatus(baseUrl, qrcode) {
+    return apiGet(baseUrl, `/ilink/bot/get_qrcode_status?qrcode=${encodeURIComponent(qrcode)}`, {
+        'iLink-App-ClientVersion': '1',
+    });
+}
+export function buildTextMessage(userId, contextToken, text) {
+    return {
+        from_user_id: '',
+        to_user_id: userId,
+        client_id: randomUUID(),
+        message_type: MessageType.BOT,
+        message_state: MessageState.FINISH,
+        context_token: contextToken,
+        item_list: [
+            {
+                type: MessageItemType.TEXT,
+                text_item: { text },
+            },
+        ],
+    };
+}
