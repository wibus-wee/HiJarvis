+import { type Credentials } from './auth.js';
+import { type IncomingMessage } from './types.js';
+type MessageHandler = (msg: IncomingMessage) => void | Promise<void>;
+export interface WeixinBotOptions {
+    baseUrl?: string;
+    tokenPath?: string;
+    onError?: (error: unknown) => void;
+}
+export declare class WeixinBot {
+    private baseUrl;
+    private readonly tokenPath?;
+    private readonly onErrorCallback?;
+    private readonly handlers;
+    private readonly contextTokens;
+    private credentials?;
+    private cursor;
+    private stopped;
+    private currentPollController;
+    private runPromise;
+    constructor(options?: WeixinBotOptions);
+    login(options?: {
+        force?: boolean;
+    }): Promise<Credentials>;
+    onMessage(handler: MessageHandler): this;
+    on(event: 'message', handler: MessageHandler): this;
+    reply(message: IncomingMessage, text: string): Promise<void>;
+    sendTyping(userId: string): Promise<void>;
+    stopTyping(userId: string): Promise<void>;
+    send(userId: string, text: string): Promise<void>;
+    run(): Promise<void>;
+    stop(): void;
+    private runLoop;
+    private ensureCredentials;
+    private sendText;
+    private dispatchMessage;
+    private rememberContext;
+    private toIncomingMessage;
+    private reportError;
+    private log;
+}
+export {};
